DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ZSL2_PACKAGE_SHA256=<64-hex-package-sha>
ZSL2_GIT_SHA=<git-sha>
ZSL2_ACTOR_ID=<service-or-human-actor>
ZSL2_SOURCE_BINDINGS_PATH=./config/source-bindings.json
ZSL2_ATTESTATION_KEY_ID=<secret-manager-key-id>
ZSL2_ATTESTATION_HMAC_SECRET=<minimum-32-character-secret-from-secret-manager>
ZSL2_POSTGRES_INTEGRATION_ATTESTATION_PATH=./evidence/runtime/postgres-integration.json
ZSL2_PERFORMANCE_ATTESTATION_PATH=./evidence/runtime/performance.json
ZSL2_RUNTIME_ROLLBACK_ATTESTATION_PATH=./evidence/runtime/rollback.json
# Positive activation runtime probe requires a disposable certified fixture:
ZSL2_RUNTIME_FIXTURE_RUN_ID=<uuid>
ZSL2_RUNTIME_FIXTURE_CERT_ID=<uuid>
