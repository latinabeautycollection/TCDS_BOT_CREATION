{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "operation",
    "component",
    "correlation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "args": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "dryRun": {
      "type": "boolean"
    },
    "cwd": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]{1,240}$"
    },
    "stdin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "fd"
          ]
        },
        "fd": {
          "type": "integer",
          "minimum": 3,
          "maximum": 9
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "change_id",
        "operator_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "test_cohort_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "change_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "operator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._:-]{1,128}$"
        },
        "traceparent": {
          "type": "string",
          "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[0-9a-f]{2}$"
        },
        "evidence_manifest_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      }
    }
  }
}
