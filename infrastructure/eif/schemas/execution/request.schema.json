{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "args",
    "operation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "dryRun": {
      "type": "boolean"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
    },
    "cwd": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stdin": {
      "type": "string",
      "maxLength": 65536
    }
  }
}
