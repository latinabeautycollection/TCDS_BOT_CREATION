{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkId",
    "component",
    "version",
    "description",
    "mode",
    "timeoutSeconds",
    "failureClass",
    "severityOnFailure",
    "command",
    "arguments",
    "environment",
    "successCriteria",
    "redaction",
    "requiredPrivileges",
    "sideEffects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,127}$"
    },
    "component": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 3
    },
    "mode": {
      "enum": [
        "command",
        "http",
        "file",
        "evidence",
        "composite"
      ]
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "failureClass": {
      "type": "string"
    },
    "severityOnFailure": {
      "type": "string"
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object"
    },
    "successCriteria": {
      "type": "object"
    },
    "redaction": {
      "type": "object"
    },
    "requiredPrivileges": {
      "type": "string"
    },
    "sideEffects": {
      "const": "none"
    }
  }
}
