{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "environment",
    "failClosed",
    "receiptAuthenticationMode",
    "receiptHmacSecretReference",
    "maxParallelChecks",
    "defaultTimeoutSeconds",
    "maxOutputBytes",
    "continuousHealth",
    "failureClasses",
    "severityLevels",
    "components",
    "evidenceCompleteness"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "engineVersion": {
      "const": "1.2.0"
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "failClosed": {
      "type": "boolean"
    },
    "receiptAuthenticationMode": {
      "enum": [
        "required_hmac",
        "optional_hmac",
        "development_hash_only"
      ]
    },
    "receiptHmacSecretReference": {
      "type": "string",
      "pattern": "^secret://env/[A-Z0-9_]+$"
    },
    "maxParallelChecks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "defaultTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    },
    "continuousHealth": {
      "type": "object"
    },
    "failureClasses": {
      "type": "array",
      "uniqueItems": true
    },
    "severityLevels": {
      "type": "array",
      "uniqueItems": true
    },
    "components": {
      "type": "object",
      "minProperties": 1
    },
    "evidenceCompleteness": {
      "type": "object"
    }
  }
}
