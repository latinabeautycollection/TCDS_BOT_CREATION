{
  "schemaVersion": "1.0",
  "engineVersion": "1.4.0",
  "environment": "production",
  "failClosed": true,
  "reportAuthenticationMode": "required_hmac",
  "reportHmacSecretReference": "secret://env/EIF_CERTIFICATION_HMAC_KEY",
  "requiredMilestones": {
    "1B.1": "0.1.0",
    "1B.2": "0.3.0",
    "1B.3": "0.5.0",
    "1B.4": "0.7.0",
    "1B.5": "0.9.0",
    "1B.6": "1.1.0",
    "1B.7": "1.3.0"
  },
  "suites": [
    "framework_core",
    "configuration",
    "structured_logging",
    "execution",
    "state_transaction",
    "backup_restore",
    "validation_health",
    "security_negative",
    "concurrency",
    "failure_injection",
    "recovery",
    "integration",
    "production_acceptance"
  ],
  "certificationThresholds": {
    "requiredPassPercentage": 100,
    "criticalFailuresAllowed": 0,
    "highFailuresAllowed": 0,
    "warningsAllowed": 5,
    "evidenceCompletenessPercentage": 100,
    "minimumCorrelationConfidence": 0.9,
    "maximumClockSkewSeconds": 2,
    "maximumDroppedTelemetryEvents": 0,
    "maximumUnhandledExceptions": 0
  },
  "productionAcceptance": {
    "requireEnvoy": true,
    "requireSuricata": true,
    "requirePqp": true,
    "requirePostgresql": true,
    "requireRedis": true,
    "requireTelemetry": true,
    "requireClockSync": true,
    "requireRemoteImmutableEvidence": true,
    "requireHmacKeys": true,
    "requireDedicatedServiceAccounts": true,
    "requireAppArmorOrEquivalent": true
  },
  "evidenceRetention": {
    "localDays": 30,
    "remoteImmutableRequired": true,
    "minimumCopies": 1
  }
}
