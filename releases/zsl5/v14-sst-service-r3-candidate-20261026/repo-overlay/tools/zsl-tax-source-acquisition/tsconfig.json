{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["acquisition/**/*.ts","adapters/**/*.ts","normalization/**/*.ts","reconciliation/**/*.ts","zsl1/**/*.ts","zsl2/**/*.ts","certification/**/*.ts","tests/**/*.ts"]
}
