{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcds.local/zsl1-tax/applicability-assertion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_code",
    "family",
    "assertion",
    "source_key",
    "source_release_id",
    "source_artifact_sha256",
    "effective_from",
    "review_status"
  ],
  "properties": {
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "family": {
      "type": "string",
      "enum": [
        "TAX_REGIME",
        "TAX_JURISDICTION",
        "TAX_JURISDICTION_ASSIGNMENT",
        "STATE_RATE",
        "LOCAL_RATE",
        "RATE_COMPONENT_RULE",
        "RATE_CAP_THRESHOLD_RULE",
        "PRODUCT_TAXABILITY",
        "TAXABLE_BASE_RULE",
        "BUNDLED_TRANSACTION_RULE",
        "ALLOCATION_RULE",
        "TAX_HOLIDAY",
        "SOURCING_RULE",
        "SELLER_COLLECTION_RULE",
        "MARKETPLACE_RULE",
        "SELLER_TAX_ELECTION",
        "EXEMPTION_RULE",
        "EXEMPTION_CERTIFICATE_REQUIREMENT",
        "TAX_CREDIT_RULE",
        "ROUNDING_RULE",
        "MANDATORY_TRANSACTION_FEE"
      ]
    },
    "assertion": {
      "type": "string",
      "enum": [
        "APPLIES",
        "DOES_NOT_APPLY",
        "NOT_AUTHORIZED",
        "NO_GENERAL_TAX",
        "NO_HOLIDAY",
        "NO_LOCAL_TAX",
        "NO_SPECIAL_FEE",
        "NO_SELLER_ELECTION"
      ]
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "source_release_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "legal_citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
