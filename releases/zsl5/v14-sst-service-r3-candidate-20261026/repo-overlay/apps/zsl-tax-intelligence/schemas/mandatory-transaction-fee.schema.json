{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcds.local/zsl1-tax/mandatory-transaction-fee.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "state_code",
    "natural_key",
    "source_key",
    "source_release_id",
    "source_artifact_sha256",
    "authority_rank",
    "retrieved_at",
    "parser_version",
    "normalization_version",
    "payload"
  ],
  "properties": {
    "record_type": {
      "const": "MANDATORY_TRANSACTION_FEE"
    },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "natural_key": {
      "type": "string",
      "minLength": 1
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "source_release_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_rank": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        99
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "parser_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "PENDING_PARSE"
      }
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "legal_citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fee_code",
        "fee_type",
        "calculation_method",
        "currency",
        "taxable_itself",
        "collection_responsibility",
        "product_applicability",
        "predicate"
      ],
      "properties": {
        "fee_code": {
          "type": "string",
          "minLength": 1
        },
        "fee_type": {
          "type": "string",
          "minLength": 1
        },
        "calculation_method": {
          "enum": [
            "FIXED",
            "PERCENTAGE_OF_BASE",
            "PER_ITEM",
            "PER_UNIT",
            "SPECIAL_RULE"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "currency": {
          "const": "USD"
        },
        "taxable_itself": {
          "type": "boolean"
        },
        "collection_responsibility": {
          "enum": [
            "SELLER",
            "MARKETPLACE",
            "BUYER",
            "OTHER"
          ]
        },
        "tax_product_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_applicability": {
          "type": "object"
        },
        "predicate": {
          "type": "object"
        }
      }
    }
  }
}
