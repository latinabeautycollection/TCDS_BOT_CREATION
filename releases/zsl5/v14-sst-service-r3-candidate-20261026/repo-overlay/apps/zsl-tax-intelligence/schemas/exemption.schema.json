{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcds.local/zsl1-tax/exemption-rule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "state_code",
    "natural_key",
    "source_key",
    "source_release_id",
    "source_artifact_sha256",
    "authority_rank",
    "retrieved_at",
    "parser_version",
    "normalization_version",
    "payload"
  ],
  "properties": {
    "record_type": {
      "const": "EXEMPTION_RULE"
    },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "natural_key": {
      "type": "string",
      "minLength": 1
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "source_release_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_rank": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        99
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "parser_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "PENDING_PARSE"
      }
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "legal_citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exemption_type",
        "eligible",
        "exempt_fraction",
        "certificate_required",
        "predicate"
      ],
      "properties": {
        "exemption_type": {
          "enum": [
            "RESALE",
            "GOVERNMENT",
            "NONPROFIT",
            "AGRICULTURAL",
            "MANUFACTURING",
            "OTHER"
          ]
        },
        "tax_product_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "jurisdiction_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "exempt_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "certificate_required": {
          "type": "boolean"
        },
        "predicate": {
          "type": "object"
        }
      }
    }
  }
}
