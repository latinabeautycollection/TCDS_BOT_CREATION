{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcds.local/zsl1-tax/bundled-transaction-rule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "state_code",
    "natural_key",
    "source_key",
    "source_release_id",
    "source_artifact_sha256",
    "authority_rank",
    "retrieved_at",
    "parser_version",
    "normalization_version",
    "payload"
  ],
  "properties": {
    "record_type": {
      "const": "BUNDLED_TRANSACTION_RULE"
    },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "natural_key": {
      "type": "string",
      "minLength": 1
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "source_release_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_rank": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        99
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "parser_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "PENDING_PARSE"
      }
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "legal_citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_code",
        "treatment",
        "predicate"
      ],
      "properties": {
        "rule_code": {
          "type": "string",
          "minLength": 1
        },
        "treatment": {
          "enum": [
            "SEPARATELY_STATED_COMPONENTS",
            "DOMINANT_COMPONENT",
            "FULLY_TAXABLE_IF_ANY_TAXABLE",
            "FULLY_EXEMPT_IF_PRIMARY_EXEMPT",
            "PRO_RATA",
            "SPECIAL_RULE"
          ]
        },
        "tax_product_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "predicate": {
          "type": "object"
        }
      }
    }
  }
}
