{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcds.local/zsl1-tax/mandatory-transaction-fee.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "state_code",
    "natural_key",
    "source_key",
    "source_release_id",
    "source_artifact_sha256",
    "authority_rank",
    "retrieved_at",
    "parser_version",
    "normalization_version",
    "payload"
  ],
  "properties": {
    "record_type": {
      "const": "MANDATORY_TRANSACTION_FEE"
    },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "natural_key": {
      "type": "string",
      "minLength": 1
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "source_release_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_rank": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        99
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "legal_citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fee_code",
        "fee_type",
        "calculation_method"
      ],
      "properties": {
        "fee_code": {
          "type": "string",
          "minLength": 1
        },
        "fee_type": {
          "type": "string",
          "minLength": 1
        },
        "calculation_method": {
          "type": "string",
          "enum": [
            "FIXED",
            "RATE",
            "PER_ITEM",
            "PER_DELIVERY",
            "PER_TRANSACTION",
            "TIERED",
            "CONDITIONAL"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "taxable_itself": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "collection_responsibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_applicability": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
